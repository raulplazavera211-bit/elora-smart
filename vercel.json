{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "src": "/manus-storage/(.*)", "dest": "/api/[...path].ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
