{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "dist/serverless/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].mjs" },
    { "src": "/manus-storage/(.*)", "dest": "/api/[...path].mjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
